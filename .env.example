# URL pública do site (usada em canonical, sitemap, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://peredadev.com.br

# Google Analytics 4 — formato G-XXXXXXXXXX. Vazio = nenhum rastreamento e nenhum banner de consentimento.
NEXT_PUBLIC_GA_ID=

# Google Search Console — apenas o valor do atributo "content" da meta tag de verificação.
GOOGLE_SITE_VERIFICATION=

# Perfis profissionais (URL completa). Vazio = o link não aparece no site.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
