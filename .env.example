# URL pública do site (usada em canonical, sitemap, Open Graph e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://peredadev.com.br

# Google Analytics 4 — formato G-XXXXXXXXXX. Vazio = nenhum rastreamento e nenhum banner de consentimento.
NEXT_PUBLIC_GA_ID=

# Google Search Console — apenas o valor do atributo "content" da meta tag de verificação.
GOOGLE_SITE_VERIFICATION=

# Perfis profissionais (URL completa). Vazio = o link não aparece no site.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Integrações de afiliados: segredos usados somente no servidor.
# Preencher apenas quando tiver credenciais e documentação oficial da API.
# A presença dessas variáveis não ativa consultas sozinha.
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=https://www.peredadev.com.br/api/afiliados/mercadolivre/callback
MERCADOLIVRE_CONNECT_USERNAME=admin
MERCADOLIVRE_CONNECT_PASSWORD=

# Armazenamento persistente e privado dos tokens OAuth (Supabase/Postgres via REST).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AMAZON_ACCESS_KEY_ID=
AMAZON_SECRET_ACCESS_KEY=
AMAZON_PARTNER_TAG=
KABUM_API_TOKEN=
TERABYTE_API_TOKEN=
